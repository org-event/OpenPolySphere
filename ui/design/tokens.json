{
  "$comment": "Brand book — single source of truth. Edit here → rerun: bun ui/design/apply-tokens.mjs",
  "meta": {
    "name": "OpenPolySphere",
    "style": "granola-inspired",
    "version": "0.1.0"
  },
  "spacing": {
    "base": 4,
    "step": 8,
    "scale": [4, 8, 16, 24, 32, 48, 64],
    "section": [32, 48, 64],
    "screenMargin": 32,
    "maxReadWidth": 680
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pill": 999
  },
  "typography": {
    "fontFamily": "Inter",
    "display": { "size": 32, "weight": "Bold" },
    "body": { "size": 16, "weight": "Regular", "lineHeight": 1.5 },
    "ui": { "size": 14, "weight": "Medium" },
    "meta": { "size": 12, "weight": "Regular", "mono": true }
  },
  "focus": {
    "width": 2,
    "offset": 2,
    "colorToken": "accent/calm"
  },
  "color": {
    "light": {
      "bg/base": "#f7f7f2",
      "bg/elevated": "#ffffff",
      "text/primary": "#1a1814",
      "text/secondary": "#6a5f52",
      "text/muted": "#9a8f82",
      "border/subtle": "#1a181414",
      "brand/open": "#2ecf7a",
      "brand/poly": "#3d9be8",
      "accent/calm": "#5b6f00",
      "semantic/live": "#3d9a5a",
      "semantic/danger": "#c44d4d",
      "bg/bubble-out": "#dfe8d4",
      "bg/bubble-in": "#ebe4e8",
      "accent/bubble-out": "#3d9be8",
      "accent/bubble-in": "#a67bb5"
    },
    "dark": {
      "bg/base": "#141310",
      "bg/elevated": "#1e1c18",
      "text/primary": "#f5f2eb",
      "text/secondary": "#a69e92",
      "text/muted": "#7a7268",
      "border/subtle": "#f5f2eb14",
      "brand/open": "#2ecf7a",
      "brand/poly": "#3d9be8",
      "accent/calm": "#8fa83a",
      "semantic/live": "#5cb87a",
      "semantic/danger": "#e07070",
      "bg/bubble-out": "#1c2420",
      "bg/bubble-in": "#221c24",
      "accent/bubble-out": "#3d9be8",
      "accent/bubble-in": "#b88fd4"
    }
